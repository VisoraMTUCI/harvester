# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.swp
*.swo

# IDE specific files (in addition to .idea)
.idea
.vscode/
*.sublime-workspace

# Build output directory
/bin/

# Environment variables file
.env

# If you're using Air for live reloading
tmp/

# If you're using a local config that shouldn't be committed
config.local.yaml
